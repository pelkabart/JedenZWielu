# Skopiuj ten plik jako .env.local i wpisz swój klucz OpenAI.
# .env.local jest w .gitignore, a hak pre-commit nie pozwoli go zacommitować.
# UWAGA: klucz trafia do zbudowanego APK – nie udostępniaj APK zbudowanego z kluczem.
EXPO_PUBLIC_OPENAI_API_KEY=

# Adres serwera gry (Azure Container Apps), np. https://jzw-server.<losowe>.westeurope.azurecontainerapps.io
# Nie jest sekretem. Instrukcja: docs/backend-azure-instrukcja.md
EXPO_PUBLIC_SERVER_URL=
