#!/bin/sh
# Blokuje commit z kluczem API (patrz docs/zabezpieczenia/ustawienia-klucz-api.md, punkt 8).
status=0

env_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)' | grep -vE '(^|/)\.env\.example$')
if [ -n "$env_files" ]; then
  echo "pre-commit: nie commituj plików z kluczami:" >&2
  echo "$env_files" | sed 's/^/  /' >&2
  echo "  Cofnij: git restore --staged <plik>" >&2
  status=1
fi

# Testy mają atrapy kluczy w tym formacie – pomijamy __tests__ i testing/.
if git diff --cached -U0 --diff-filter=ACMR -- . ':(exclude,glob)**/__tests__/**' ':(exclude,glob)**/testing/**' | grep -E '^\+' | grep -vE '^\+\+\+ ' | grep -qE 'sk-[A-Za-z0-9_-]{20,}'; then
  echo "pre-commit: w zmianach jest tekst wyglądający na klucz OpenAI (sk-...)." >&2
  echo "  Wpisz klucz w .env.local, nie w kodzie." >&2
  status=1
fi

exit $status
