{
  "expo": {
    "name": "JedenZWielu",
    "slug": "JedenZWielu",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "jedenzwielu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Gra rozpoznaje mowę, żeby można było odpowiadać na pytania głosem.",
        "NSMicrophoneUsageDescription": "Gra używa mikrofonu, żeby można było odpowiadać na pytania głosem."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.pelkabart.JedenZWielu"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "./plugins/withVoiceModel",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Gra używa mikrofonu, żeby można było odpowiadać na pytania głosem.",
          "speechRecognitionPermission": "Gra rozpoznaje mowę, żeby można było odpowiadać na pytania głosem."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "voiceModelAsset": {},
      "eas": {
        "projectId": "e9508031-c98e-4171-a1de-8ab5c551273a"
      }
    }
  }
}
